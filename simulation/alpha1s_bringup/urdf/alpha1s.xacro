<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alpha1s">

    <material name="white"><color rgba="1 1 1 1"/></material>
    <material name="blue"><color rgba="0 0 0.8 1"/></material>
    <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

    <!-- ============================================================ -->
    <!-- World Anchor                                                  -->
    <!-- NOTE: rpy="0 -1.5708 0" compensa la orientación de los       -->
    <!-- meshes STL (exportados con X-forward). Ajustar si los meshes  -->
    <!-- se re-exportan con Z-up.                                      -->
    <!-- ============================================================ -->
    <link name="world_root"/>
    <joint name="world_joint" type="fixed">
        <parent link="world_root"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.5" rpy="0 -1.5708 0"/>
    </joint>

    <!-- ============================================================ -->
    <!-- Torso (Base Link)                                             -->
    <!-- ============================================================ -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/base_link.stl"/></geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.113 0.09 0.18"/></geometry>
        </collision>
        <inertial>
            <mass value="0.73"/>
            <inertia ixx="0.00285" ixy="0" ixz="0"
                     iyy="0.00285" iyz="0"
                     izz="0.00175"/>
        </inertial>
    </link>

    <!-- ============================================================ -->
    <!-- ===============  PIERNA DERECHA (5 DOF)  =================== -->
    <!-- ============================================================ -->

    <!-- 1. Hip Roll (eje X) -->
    <joint name="r_hip_roll_joint" type="revolute">
        <parent link="base_link"/>
        <child link="r_hip_roll_link"/>
        <origin xyz="0.0 -0.045 -0.02" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
    </joint>

    <link name="r_hip_roll_link">
        <visual>
            <origin xyz="0 0.045 0.02" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/r_hip_roll_link.stl"/></geometry>
            <material name="blue"/>
        </visual>
        <collision><geometry><box size="0.04 0.04 0.04"/></geometry></collision>
        <inertial>
            <mass value="0.08"/>
            <inertia ixx="0.00002" ixy="0" ixz="0"
                     iyy="0.00002" iyz="0"
                     izz="0.00002"/>
        </inertial>
    </link>

    <!-- 2. Hip Pitch (eje Y) — NUEVO: permite balanceo adelante/atrás -->
    <joint name="r_hip_pitch_joint" type="revolute">
        <parent link="r_hip_roll_link"/>
        <child link="r_hip_pitch_link"/>
        <origin xyz="0.0 0.0 -0.025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.8" upper="0.8" effort="10" velocity="1.0"/>
    </joint>

    <link name="r_hip_pitch_link">
        <visual>
            <geometry><box size="0.035 0.035 0.025"/></geometry>
            <material name="grey"/>
        </visual>
        <collision><geometry><box size="0.035 0.035 0.025"/></geometry></collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.00001" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0"
                     izz="0.00001"/>
        </inertial>
    </link>

    <!-- 3. Knee (eje Y) -->
    <joint name="r_knee_joint" type="revolute">
        <parent link="r_hip_pitch_link"/>
        <child link="r_knee_link"/>
        <origin xyz="0.0 0.0 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5" upper="0.0" effort="10" velocity="1.0"/>
    </joint>

    <link name="r_knee_link">
        <visual>
            <origin xyz="0 0.045 0.095" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/r_knee_link.stl"/></geometry>
        </visual>
        <collision><geometry><box size="0.04 0.04 0.08"/></geometry></collision>
        <inertial>
            <mass value="0.12"/>
            <inertia ixx="0.00008" ixy="0" ixz="0"
                     iyy="0.00008" iyz="0"
                     izz="0.00003"/>
        </inertial>
    </link>

    <!-- 4. Ankle Pitch (eje Y) -->
    <joint name="r_ankle_pitch_joint" type="revolute">
        <parent link="r_knee_link"/>
        <child link="r_ankle_pitch_link"/>
        <origin xyz="0.0 0.0 -0.065" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
    </joint>

    <link name="r_ankle_pitch_link">
        <visual>
            <origin xyz="0 0.045 0.16" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/r_ankle_pitch_link.stl"/></geometry>
        </visual>
        <collision><geometry><box size="0.03 0.04 0.03"/></geometry></collision>
        <inertial>
            <mass value="0.07"/>
            <inertia ixx="0.00002" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0"
                     izz="0.00002"/>
        </inertial>
    </link>

    <!-- 5. Ankle Roll (eje X) -->
    <joint name="r_ankle_roll_joint" type="revolute">
        <parent link="r_ankle_pitch_link"/>
        <child link="r_ankle_link"/>
        <origin xyz="0.0 0.0 -0.015" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.3" upper="0.3" effort="10" velocity="1.0"/>
    </joint>

    <link name="r_ankle_link">
        <visual>
            <origin xyz="0 0.045 0.175" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/r_ankle_link.stl"/></geometry>
        </visual>
        <collision><geometry><box size="0.03 0.03 0.03"/></geometry></collision>
        <inertial>
            <mass value="0.04"/>
            <inertia ixx="0.00001" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0"
                     izz="0.00001"/>
        </inertial>
    </link>

    <!-- Foot (fijo) -->
    <joint name="r_foot_joint" type="fixed">
        <parent link="r_ankle_link"/>
        <child link="r_foot_link"/>
        <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
    </joint>

    <link name="r_foot_link">
        <visual>
            <origin xyz="0 0.045 0.195" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/r_foot_link.stl"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.01" rpy="0 0 0"/>
            <geometry><box size="0.1 0.06 0.02"/></geometry>
        </collision>
        <inertial>
            <mass value="0.10"/>
            <inertia ixx="0.00003" ixy="0" ixz="0"
                     iyy="0.00009" iyz="0"
                     izz="0.00011"/>
        </inertial>
    </link>

    <!-- ============================================================ -->
    <!-- ===============  PIERNA IZQUIERDA (5 DOF)  ================= -->
    <!-- ============================================================ -->

    <!-- 1. Hip Roll (eje X) -->
    <joint name="l_hip_roll_joint" type="revolute">
        <parent link="base_link"/>
        <child link="l_hip_roll_link"/>
        <origin xyz="0.0 0.045 -0.02" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
    </joint>

    <link name="l_hip_roll_link">
        <visual>
            <origin xyz="0 -0.045 0.02" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/l_hip_roll_link.stl"/></geometry>
            <material name="blue"/>
        </visual>
        <collision><geometry><box size="0.04 0.04 0.04"/></geometry></collision>
        <inertial>
            <mass value="0.08"/>
            <inertia ixx="0.00002" ixy="0" ixz="0"
                     iyy="0.00002" iyz="0"
                     izz="0.00002"/>
        </inertial>
    </link>

    <!-- 2. Hip Pitch (eje Y) — NUEVO -->
    <joint name="l_hip_pitch_joint" type="revolute">
        <parent link="l_hip_roll_link"/>
        <child link="l_hip_pitch_link"/>
        <origin xyz="0.0 0.0 -0.025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.8" upper="0.8" effort="10" velocity="1.0"/>
    </joint>

    <link name="l_hip_pitch_link">
        <visual>
            <geometry><box size="0.035 0.035 0.025"/></geometry>
            <material name="grey"/>
        </visual>
        <collision><geometry><box size="0.035 0.035 0.025"/></geometry></collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.00001" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0"
                     izz="0.00001"/>
        </inertial>
    </link>

    <!-- 3. Knee (eje Y) -->
    <joint name="l_knee_joint" type="revolute">
        <parent link="l_hip_pitch_link"/>
        <child link="l_knee_link"/>
        <origin xyz="0.0 0.0 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5" upper="0.0" effort="10" velocity="1.0"/>
    </joint>

    <link name="l_knee_link">
        <visual>
            <origin xyz="0 -0.045 0.095" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/l_knee_link.stl"/></geometry>
        </visual>
        <collision><geometry><box size="0.04 0.04 0.08"/></geometry></collision>
        <inertial>
            <mass value="0.12"/>
            <inertia ixx="0.00008" ixy="0" ixz="0"
                     iyy="0.00008" iyz="0"
                     izz="0.00003"/>
        </inertial>
    </link>

    <!-- 4. Ankle Pitch (eje Y) -->
    <joint name="l_ankle_pitch_joint" type="revolute">
        <parent link="l_knee_link"/>
        <child link="l_ankle_pitch_link"/>
        <origin xyz="0.0 0.0 -0.065" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
    </joint>

    <link name="l_ankle_pitch_link">
        <visual>
            <origin xyz="0 -0.045 0.16" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/l_ankle_pitch_link.stl"/></geometry>
        </visual>
        <collision><geometry><box size="0.03 0.04 0.03"/></geometry></collision>
        <inertial>
            <mass value="0.07"/>
            <inertia ixx="0.00002" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0"
                     izz="0.00002"/>
        </inertial>
    </link>

    <!-- 5. Ankle Roll (eje X) -->
    <joint name="l_ankle_roll_joint" type="revolute">
        <parent link="l_ankle_pitch_link"/>
        <child link="l_ankle_link"/>
        <origin xyz="0.0 0.0 -0.015" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.3" upper="0.3" effort="10" velocity="1.0"/>
    </joint>

    <link name="l_ankle_link">
        <visual>
            <origin xyz="0 -0.045 0.175" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/l_ankle_link.stl"/></geometry>
        </visual>
        <collision><geometry><box size="0.03 0.03 0.03"/></geometry></collision>
        <inertial>
            <mass value="0.04"/>
            <inertia ixx="0.00001" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0"
                     izz="0.00001"/>
        </inertial>
    </link>

    <!-- Foot (fijo) -->
    <joint name="l_foot_joint" type="fixed">
        <parent link="l_ankle_link"/>
        <child link="l_foot_link"/>
        <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
    </joint>

    <link name="l_foot_link">
        <visual>
            <origin xyz="0 -0.045 0.195" rpy="0 0 0"/>
            <geometry><mesh filename="package://alpha1s_bringup/meshes/l_foot_link.stl"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.01" rpy="0 0 0"/>
            <geometry><box size="0.1 0.06 0.02"/></geometry>
        </collision>
        <inertial>
            <mass value="0.10"/>
            <inertia ixx="0.00003" ixy="0" ixz="0"
                     iyy="0.00009" iyz="0"
                     izz="0.00011"/>
        </inertial>
    </link>

    <!-- ============================================================ -->
    <!-- Gazebo: Propiedades de contacto para los pies                 -->
    <!-- ============================================================ -->
    <gazebo reference="r_foot_link">
        <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd>
    </gazebo>
    <gazebo reference="l_foot_link">
        <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd>
    </gazebo>

</robot>