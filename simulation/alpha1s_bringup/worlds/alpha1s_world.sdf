        <i_max>1.0</i_max><i_min>-1.0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
      </plugin>

      <!-- Caderas roll (2) -->
      <plugin filename="ignition-gazebo-joint-position-controller-system"
